# Sound dock — optional. Without any of these the dock still plays pasted
# Spotify / Apple Music links in each provider's own embed player.
# Copy to .env.local for local dev; set the same names in Netlify for deploys.

# ── Spotify: connect an account (browser) ──────────────────────────────────
# Client ID of an app from the Spotify developer dashboard. It is public by
# design (PKCE flow, no secret). Unset = the Connect button is hidden.
VITE_SPOTIFY_CLIENT_ID=
# Optional. Must match a Redirect URI registered on that Spotify app exactly.
# Defaults to the site origin with a trailing slash, e.g. https://your-site/
VITE_SPOTIFY_REDIRECT_URI=

# ── Apple Music: connect an account (server-side, Netlify Function) ────────
# From an Apple Developer Program account: a MusicKit key (.p8) and its IDs.
# These are read only by netlify/functions/apple-music-token.mjs and are
# NEVER prefixed VITE_ — the private key must not reach the browser.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
# Full .p8 contents. Real newlines or \n escapes both work.
APPLE_MUSIC_PRIVATE_KEY=
# Recommended: comma-separated origins the token is valid for, e.g.
# https://your-site.netlify.app,https://www.your-domain.com
APPLE_MUSIC_ALLOWED_ORIGINS=

# ── Optional house playlists (share links) ─────────────────────────────────
VITE_SPOTIFY_HOUSE_PLAYLIST=
VITE_APPLE_MUSIC_HOUSE_PLAYLIST=
